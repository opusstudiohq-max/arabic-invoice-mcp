{
  "name": "nasq",
  "version": "0.1.0",
  "description": "Correct Arabic text in PDFs: Unicode bidi (UAX #9) + OpenType shaping composed in the right order, so invoice totals stop printing backwards | نصّ عربي صحيح في PDF — ترتيب ثنائي الاتجاه وتشكيل، مركَّبان بالترتيب الصحيح",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pdf-lib": {
      "types": "./dist/pdf.d.ts",
      "default": "./dist/pdf.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "fetch-ucd": "node fetch-ucd.mjs",
    "test": "npm run build && node --test tests/runs.test.mjs tests/pdf.test.mjs",
    "test:conformance": "node --test tests/conformance.test.mjs"
  },
  "keywords": [
    "arabic",
    "bidi",
    "bidirectional",
    "uax9",
    "rtl",
    "shaping",
    "pdf",
    "pdf-lib",
    "invoice",
    "عربي",
    "فاتورة",
    "unicode"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bidi-js": "^1.0.3"
  },
  "peerDependencies": {
    "pdf-lib": "^1.17.0"
  },
  "peerDependenciesMeta": {
    "pdf-lib": {
      "optional": true
    }
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "fontkit": "^2.0.4",
    "pdf-lib": "^1.17.1",
    "typescript": "^5.6.0"
  }
}
