{
  "name": "fatura",
  "version": "0.1.0",
  "description": "Arabic tax-invoice PDF: correct bidi text, halala-exact totals, and a ZATCA Phase-1 QR built from the authority's own specification text | فاتورة ضريبية عربية بصيغة PDF — نصّ مرتَّب صحيحاً، ومجاميع بالهللات، ورمز QR مبنيّ على نصّ المواصفة",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./zatca-qr": {
      "types": "./dist/zatca-qr.d.ts",
      "default": "./dist/zatca-qr.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test tests/zatca-qr.test.mjs tests/model.test.mjs tests/render.test.mjs"
  },
  "keywords": [
    "zatca",
    "einvoice",
    "e-invoice",
    "invoice",
    "pdf",
    "arabic",
    "rtl",
    "saudi",
    "vat",
    "qr",
    "فاتورة",
    "ضريبة",
    "عربي"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "nasq": "file:../nasq",
    "pdf-lib": "^1.17.1",
    "qrcode-generator": "^1.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "fontkit": "^2.0.4",
    "jsqr": "^1.4.0",
    "typescript": "^5.6.0"
  }
}
